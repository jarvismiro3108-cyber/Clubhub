{
  // Club Hub: website in ./public, AI endpoint in worker.js (/api/analyze, /api/test)
  "name": "clubhub",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // per-visitor limit for the AI endpoint (5 requests per minute)
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "keep_vars": true
}
